  <script>
    const firebaseConfig = {
      apiKey: "AIzaSyB4s_pa7cCXf8PBnHMEpxygxuBxdGHEmDQ",
      authDomain: "voltio-f44f6.firebaseapp.com",
      projectId: "voltio-f44f6",
      storageBucket: "voltio-f44f6.firebasestorage.app",
      messagingSenderId: "331631083093",
      appId: "1:331631083093:web:7c401ccdaeea9b5e2cdedc",
      measurementId: "G-4HF5TJ91XF"
    };

    firebase.initializeApp(firebaseConfig);
    const auth = firebase.auth();
    const db = firebase.firestore();

    let isRegisterMode = false;
    let currentUserEmail = "";
    let data = { clientes: [], trabajos: [], recordatorios: [] };
    let tempMediaFiles = [];
    let tempAudioFiles = [];
    let toastTimeout = null;

    // Grabación de Audio
    let mediaRecorder = null;
    let audioChunks = [];
    let isRecording = false;
    let recordTimerInterval = null;
    let recordSeconds = 0;

    document.addEventListener("DOMContentLoaded", () => {
      if ("Notification" in window && Notification.permission !== "granted") {
        Notification.requestPermission();
      }
      if (window.innerWidth <= 768) {
        document.getElementById('close-menu-btn').style.display = 'block';
      }

      auth.onAuthStateChanged((user) => {
        if (user) {
          initAppSession(user.email);
        }
      });
    });

    function showToast(message, isSuccess = false, duration = 4000) {
      const toast = document.getElementById('toast-notification');
      const icon = document.getElementById('toast-icon');
      const msg = document.getElementById('toast-message');

      msg.innerText = message;
      toast.className = isSuccess ? "show success" : "show";
      icon.className = isSuccess ? "fa-solid fa-circle-check" : "fa-solid fa-cloud-arrow-up";

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.className = "";
      }, duration);
    }

    function switchAuthMode(mode) {
      isRegisterMode = (mode === 'register');
      document.getElementById('tab-login-btn').classList.toggle('active', !isRegisterMode);
      document.getElementById('tab-reg-btn').classList.toggle('active', isRegisterMode);
      document.getElementById('auth-submit-btn').innerText = isRegisterMode ? 'Registrar Cuenta' : 'Entrar';
    }

    function handleAuth() {
      const email = document.getElementById('auth-email').value.trim();
      const pass = document.getElementById('auth-password').value.trim();
      if(!email || !pass) { alert("Completa correo y contraseña"); return; }

      const btn = document.getElementById('auth-submit-btn');
      btn.innerText = "Procesando...";
      btn.disabled = true;

      const authAction = isRegisterMode 
        ? auth.createUserWithEmailAndPassword(email, pass) 
        : auth.signInWithEmailAndPassword(email, pass);

      authAction
        .then((userCredential) => {
          initAppSession(userCredential.user.email);
        })
        .catch((error) => {
          alert("Error: " + error.message);
          btn.innerText = isRegisterMode ? 'Registrar Cuenta' : 'Entrar';
          btn.disabled = false;
        });
    }

    function initAppSession(email) {
      currentUserEmail = email;
      document.getElementById('current-user-label').innerText = email;
      document.getElementById('auth-screen').style.display = 'none';
      document.getElementById('app-container').style.display = 'flex';
      initRealtimeSync();
    }

    function logoutApp() {
      auth.signOut().then(() => { location.reload(); });
    }

    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      sidebar.classList.toggle('mobile-open');
    }

    function switchTab(tabId, element) {
      document.querySelectorAll('.view-section').forEach(sec => sec.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
      if(element) element.classList.add('active');

      if (window.innerWidth <= 768) {
        document.getElementById('sidebar').classList.remove('mobile-open');
      }
    }

    function switchTabBySelector(tabId, index) {
      const navItems = document.querySelectorAll('.nav-item');
      switchTab(tabId, navItems[index]);
    }

    function openModal(id) { document.getElementById(id).classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    // CALIDAD DE IMÁGENES ALTA (Alta resolución y nitidez sin pixelado)
    function handleFileSelection(event) {
      const files = event.target.files;
      if (!files) return;

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const reader = new FileReader();

        reader.onload = function(e) {
          const img = new Image();
          img.onload = function() {
            const canvas = document.createElement('canvas');
            const MAX_WIDTH = 1920;  
            const MAX_HEIGHT = 1920; 
            let width = img.width;
            let height = img.height;

            if (width > height) {
              if (width > MAX_WIDTH) {
                height *= MAX_WIDTH / width;
                width = MAX_WIDTH;
              }
            } else {
              if (height > MAX_HEIGHT) {
                width *= MAX_HEIGHT / height;
                height = MAX_HEIGHT;
              }
            }

            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            const highQualityDataUrl = canvas.toDataURL('image/jpeg', 0.92);
            tempMediaFiles.push(highQualityDataUrl);
            renderTempMediaPreviews();
          };
          img.src = e.target.result;
        };
        reader.readAsDataURL(file);
      }
      event.target.value = "";
    }

    function renderTempMediaPreviews() {
      const container = document.getElementById('upload-preview-container');
      container.innerHTML = "";
      tempMediaFiles.forEach((media, index) => {
        const thumb = document.createElement('img');
        thumb.src = media;
        thumb.className = "media-thumb";
        thumb.onclick = () => openImageVisor(media);
        container.appendChild(thumb);
      });
    }

    function openImageVisor(src) {
      const visor = document.getElementById('modal-visor-imagen');
      const container = document.getElementById('visor-contenido-container');
      container.innerHTML = `<img src="${src}" style="max-width: 100%; max-height: 85vh; border-radius: 8px; object-fit: contain;">`;
      visor.classList.add('active');
    }

    // AUDIO RECORDING LOGIC
    function toggleRecordAudio() {
      if (!isRecording) {
        startAudioRecording();
      } else {
        stopAudioRecording();
      }
    }

    function startAudioRecording() {
      audioChunks = [];
      navigator.mediaDevices.getUserMedia({ audio: true })
        .then(stream => {
          mediaRecorder = new MediaRecorder(stream);
          mediaRecorder.ondataavailable = event => {
            if (event.data.size > 0) audioChunks.push(event.data);
          };
          mediaRecorder.onstop = () => {
            const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
            const reader = new FileReader();
            reader.onload = function(e) {
              tempAudioFiles.push(e.target.result);
              renderTempAudioList();
            };
            reader.readAsDataURL(audioBlob);
          };
          mediaRecorder.start();
          isRecording = true;
          document.getElementById('btn-record-audio').className = "btn-record recording";
          document.getElementById('rec-btn-text').innerText = "Detener Grabación";
          
          recordSeconds = 0;
          document.getElementById('rec-timer').innerText = "00:00";
          recordTimerInterval = setInterval(() => {
            recordSeconds++;
            let mins = Math.floor(recordSeconds / 60).toString().padStart(2, '0');
            let secs = (recordSeconds % 60).toString().padStart(2, '0');
            document.getElementById('rec-timer').innerText = `${mins}:${secs}`;
          }, 1000);
        })
        .catch(err => {
          alert("No se pudo acceder al micrófono: " + err.message);
        });
    }

    function stopAudioRecording() {
      if (mediaRecorder && isRecording) {
        mediaRecorder.stop();
        mediaRecorder.stream.getTracks().forEach(track => track.stop());
      }
      isRecording = false;
      clearInterval(recordTimerInterval);
      document.getElementById('btn-record-audio').className = "btn-record";
      document.getElementById('rec-btn-text').innerText = "Grabar Nota de Voz";
      document.getElementById('rec-timer').innerText = "00:00";
    }

    function renderTempAudioList() {
      const container = document.getElementById('audio-list-container');
      container.innerHTML = "";
      tempAudioFiles.forEach((audioSrc, index) => {
        const box = document.createElement('div');
        box.className = "audio-item-box";
        box.innerHTML = `
          <span style="font-size: 14px; font-weight: 500;"><i class="fa-solid fa-microphonelines" style="color: var(--accent-green);"></i> Nota de voz #${index + 1}</span>
          <div style="display: flex; gap: 6px; align-items: center;">
            <audio controls src="${audioSrc}" style="height: 32px; width: 180px;"></audio>
            <button type="button" class="btn-danger" style="padding: 4px 8px; font-size: 13px;" onclick="removeTempAudio(${index})"><i class="fa-solid fa-trash"></i></button>
          </div>
        `;
        container.appendChild(box);
      });
    }

    function removeTempAudio(index) {
      tempAudioFiles.splice(index, 1);
      renderTempAudioList();
    }

    // FIRESTORE SYNC & OPTIMIZED NON-BLOCKING SAVE
    function initRealtimeSync() {
      db.collection("usuarios").doc(currentUserEmail).onSnapshot((doc) => {
        if (doc.exists) {
          data = doc.data();
          if(!data.clientes) data.clientes = [];
          if(!data.trabajos) data.trabajos = [];
          if(!data.recordatorios) data.recordatorios = [];
        } else {
          data = { clientes: [], trabajos: [], recordatorios: [] };
          saveDataToFirebase();
        }
        renderAll();
      });
    }

    function saveDataToFirebase(onComplete) {
      db.collection("usuarios").doc(currentUserEmail).set(data)
        .then(() => {
          if (onComplete) onComplete();
        })
        .catch((error) => {
          console.error("Error al guardar:", error);
        });
    }

    // GUARDAR TRABAJO OPTIMIZADO EN SEGUNDO PLANO
    function saveTrabajo(e) {
      e.preventDefault();
      
      const id = document.getElementById('edit-trab-id').value;
      const clienteId = document.getElementById('trab-cliente').value;
      const fecha = document.getElementById('trab-fecha').value || new Date().toISOString().split('T')[0];
      const estado = document.getElementById('trab-estado').value;
      const descripcion = document.getElementById('trab-desc').value;

      const clienteObj = data.clientes.find(c => c.id === clienteId);
      const clienteNombre = clienteObj ? clienteObj.nombre : "Sin Cliente";

      const trabajoData = {
        id: id ? id : 'trab_' + Date.now(),
        clienteId,
        clienteNombre,
        fecha,
        estado,
        descripcion,
        media: [...tempMediaFiles],
        audios: [...tempAudioFiles],
        createdAt: id ? (data.trabajos.find(t => t.id === id)?.createdAt || Date.now()) : Date.now()
      };

      if (id) {
        const index = data.trabajos.findIndex(t => t.id === id);
        if (index !== -1) data.trabajos[index] = trabajoData;
      } else {
        data.trabajos.unshift(trabajoData);
      }

      closeModal('modal-trabajo');
      showToast("Guardando en segundo plano...", false, 3000);

      saveDataToFirebase(() => {
        showToast("¡Trabajo guardado con éxito!", true, 3000);
      });

      tempMediaFiles = [];
      tempAudioFiles = [];
      document.getElementById('form-trabajo').reset();
      document.getElementById('upload-preview-container').innerHTML = "";
      document.getElementById('audio-list-container').innerHTML = "";
    }

    function openCreateClientModal() {
      document.getElementById('edit-cli-id').value = "";
      document.getElementById('form-detalle-cliente').reset();
      document.getElementById('modal-cli-title').innerText = "Nuevo Cliente";
      openModal('modal-detalle-cliente');
    }

    function openCreateTrabajoModal() {
      document.getElementById('edit-trab-id').value = "";
      document.getElementById('form-trabajo').reset();
      document.getElementById('modal-trabajo-title').innerText = "Nuevo Trabajo";
      tempMediaFiles = [];
      tempAudioFiles = [];
      document.getElementById('upload-preview-container').innerHTML = "";
      document.getElementById('audio-list-container').innerHTML = "";
      
      const select = document.getElementById('trab-cliente');
      select.innerHTML = "";
      if(data.clientes.length === 0) {
        select.innerHTML = `<option value="">Primero registra un cliente</option>`;
      } else {
        data.clientes.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c.id;
          opt.innerText = c.nombre;
          select.appendChild(opt);
        });
      }
      openModal('modal-trabajo');
    }

    function updateCliente(e) {
      e.preventDefault();
      const id = document.getElementById('edit-cli-id').value;
      const nombre = document.getElementById('edit-cli-nombre').value;
      const telefono = document.getElementById('edit-cli-telefono').value;
      const email = document.getElementById('edit-cli-email').value;
      const direccion = document.getElementById('edit-cli-direccion').value;
      const notas = document.getElementById('edit-cli-notas').value;

      if(id) {
        const cli = data.clientes.find(c => c.id === id);
        if(cli) {
          cli.nombre = nombre;
          cli.telefono = telefono;
          cli.email = email;
          cli.direccion = direccion;
          cli.notas = notas;
        }
      } else {
        const nuevoCliente = {
          id: 'cli_' + Date.now(),
          nombre, telefono, email, direccion, notas
        };
        data.clientes.unshift(nuevoCliente);
      }

      closeModal('modal-detalle-cliente');
      saveDataToFirebase();
      showToast("Cliente guardado correctamente", true);
    }

    function deleteClientPrompt() {
      const id = document.getElementById('edit-cli-id').value;
      if(confirm("¿Estás seguro de eliminar este cliente?")) {
        data.clientes = data.clientes.filter(c => c.id !== id);
        closeModal('modal-detalle-cliente');
        saveDataToFirebase();
        showToast("Cliente eliminado", true);
      }
    }

    function renderAll() {
      renderPanelStats();
      renderClientes();
      renderTrabajos();
      renderEnCurso();
      renderTerminados();
      renderRecordatorios();
    }

    function renderPanelStats() {
      const totalClientes = data.clientes.length;
      const pendientes = data.trabajos.filter(t => t.estado === 'Pendiente' || !t.estado).length;
      const enCurso = data.trabajos.filter(t => t.estado === 'En Curso').length;
      const terminados = data.trabajos.filter(t => t.estado === 'Terminado').length;
      const avisos = data.recordatorios.length;

      document.getElementById('count-clientes').innerText = totalClientes;
      document.getElementById('count-trabajos').innerText = pendientes;
      document.getElementById('count-en-curso').innerText = enCurso;
      document.getElementById('count-terminados').innerText = terminados;
      document.getElementById('count-pendientes').innerText = avisos;
    }

    function renderClientes() {
      const box = document.getElementById('clientes-list-box');
      document.getElementById('total-clientes-sub').innerText = data.clientes.length;
      if(data.clientes.length === 0) {
        box.innerHTML = `<i class="fa-solid fa-user-slash" style="font-size: 24px; margin-bottom: 8px;"></i><p>No hay clientes aún</p>`;
        return;
      }
      box.className = "";
      box.style.background = "transparent";
      box.style.border = "none";
      box.style.padding = "0";
      box.innerHTML = "";

      data.clientes.forEach(c => {
        const card = document.createElement('div');
        card.className = "client-card";
        card.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
              <h3 style="font-size: 18px; font-weight: bold; color: var(--text-main);">${c.nombre}</h3>
              <p style="font-size: 14px; color: var(--text-muted); margin-top: 2px;">${c.direccion || 'Sin dirección'}</p>
            </div>
            <button class="btn-secondary" style="padding: 6px 10px; font-size: 14px;" onclick="editClienteModal('${c.id}')"><i class="fa-solid fa-pen"></i></button>
          </div>
          <div class="client-links">
            ${c.telefono ? `<a href="https://wa.me/${c.telefono.replace(/\D/g,'')}" target="_blank"><i class="fa-brands fa-whatsapp" style="color: #25d366;"></i> WhatsApp</a>` : ''}
            ${c.telefono ? `<a href="tel:${c.telefono}"><i class="fa-solid fa-phone"></i> Llamar</a>` : ''}
            ${c.direccion ? `<a href="https://maps.google.com/?q=${encodeURIComponent(c.direccion)}" target="_blank"><i class="fa-solid fa-map-location-dot"></i> GPS</a>` : ''}
          </div>
        `;
        box.appendChild(card);
      });
    }

    function editClienteModal(id) {
      const c = data.clientes.find(x => x.id === id);
      if(!c) return;
      document.getElementById('edit-cli-id').value = c.id;
      document.getElementById('edit-cli-nombre').value = c.nombre || '';
      document.getElementById('edit-cli-telefono').value = c.telefono || '';
      document.getElementById('edit-cli-email').value = c.email || '';
      document.getElementById('edit-cli-direccion').value = c.direccion || '';
      document.getElementById('edit-cli-notas').value = c.notas || '';
      document.getElementById('modal-cli-title').innerText = "Editar Cliente";
      openModal('modal-detalle-cliente');
    }

    function renderTrabajos() {
      const box = document.getElementById('trabajos-list-box');
      const pendientes = data.trabajos.filter(t => t.estado === 'Pendiente' || !t.estado);
      document.getElementById('total-trabajos-sub').innerText = pendientes.length;

      if(pendientes.length === 0) {
        box.innerHTML = `<i class="fa-solid fa-screwdriver-wrench" style="font-size: 24px; margin-bottom: 8px;"></i><p>No hay trabajos pendientes</p>`;
        return;
      }
      box.className = "";
      box.style.background = "transparent";
      box.style.border = "none";
      box.style.padding = "0";
      box.innerHTML = "";

      pendientes.forEach(t => {
        const card = document.createElement('div');
        card.className = "work-card";
        card.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
              <span style="font-size: 12px; background: rgba(16, 185, 129, 0.15); color: var(--accent-green); padding: 3px 8px; border-radius: 4px; font-weight: bold;">Pendiente</span>
              <h3 style="font-size: 18px; font-weight: bold; margin-top: 6px;">${t.clienteNombre}</h3>
              <p style="font-size: 14px; color: var(--text-muted); margin-top: 2px;">${t.descripcion || 'Sin descripción'}</p>
            </div>
            <div style="display: flex; gap: 6px;">
              <button class="btn-warning" style="padding: 8px 10px;" onclick="pasarEnCurso('${t.id}')" title="Pasar a En Curso"><i class="fa-solid fa-spinner"></i></button>
              <button class="btn-success" style="padding: 8px 10px;" onclick="marcarTerminado('${t.id}')" title="Terminar"><i class="fa-solid fa-check"></i></button>
              <button class="btn-secondary" style="padding: 8px 10px;" onclick="editTrabajoModal('${t.id}')"><i class="fa-solid fa-pen"></i></button>
            </div>
          </div>
          <div style="font-size: 13px; color: var(--text-muted); display: flex; gap: 12px; margin-top: 4px;">
            <span><i class="fa-solid fa-calendar"></i> ${t.fecha}</span>
            <span><i class="fa-solid fa-camera"></i> ${t.media ? t.media.length : 0} fotos</span>
            <span><i class="fa-solid fa-microphone"></i> ${t.audios ? t.audios.length : 0} audios</span>
          </div>
        `;
        box.appendChild(card);
      });
    }

    function renderEnCurso() {
      const box = document.getElementById('en-curso-list-box');
      const enCurso = data.trabajos.filter(t => t.estado === 'En Curso');
      document.getElementById('total-en-curso-sub').innerText = enCurso.length;

      if(enCurso.length === 0) {
        box.innerHTML = `<i class="fa-solid fa-spinner" style="font-size: 24px; margin-bottom: 8px; color: #3b82f6;"></i><p>No hay trabajos en curso</p>`;
        return;
      }
      box.className = "";
      box.style.background = "transparent";
      box.style.border = "none";
      box.style.padding = "0";
      box.innerHTML = "";

      enCurso.forEach(t => {
        const card = document.createElement('div');
        card.className = "work-card";
        card.style.borderColor = "rgba(59, 130, 246, 0.3)";
        card.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
              <span style="font-size: 12px; background: rgba(59, 130, 246, 0.15); color: #3b82f6; padding: 3px 8px; border-radius: 4px; font-weight: bold;"><i class="fa-solid fa-spinner"></i> En Curso</span>
              <h3 style="font-size: 18px; font-weight: bold; margin-top: 6px;">${t.clienteNombre}</h3>
              <p style="font-size: 14px; color: var(--text-muted); margin-top: 2px;">${t.descripcion || 'Sin descripción'}</p>
            </div>
            <div style="display: flex; gap: 6px;">
              <button class="btn-success" style="padding: 8px 10px;" onclick="marcarTerminado('${t.id}')" title="Terminar"><i class="fa-solid fa-check"></i></button>
              <button class="btn-secondary" style="padding: 8px 10px;" onclick="editTrabajoModal('${t.id}')"><i class="fa-solid fa-pen"></i></button>
            </div>
          </div>
          <div style="font-size: 13px; color: var(--text-muted); display: flex; gap: 12px; margin-top: 4px;">
            <span><i class="fa-solid fa-calendar"></i> ${t.fecha}</span>
            <span><i class="fa-solid fa-camera"></i> ${t.media ? t.media.length : 0} fotos</span>
            <span><i class="fa-solid fa-microphone"></i> ${t.audios ? t.audios.length : 0} audios</span>
          </div>
        `;
        box.appendChild(card);
      });
    }

    function pasarEnCurso(id) {
      const t = data.trabajos.find(x => x.id === id);
      if(t) {
        t.estado = 'En Curso';
        saveDataToFirebase();
        showToast("Trabajo cambiado a En Curso", true);
      }
    }

    function editTrabajoModal(id) {
      const t = data.trabajos.find(x => x.id === id);
      if(!t) return;
      document.getElementById('edit-trab-id').value = t.id;
      document.getElementById('trab-fecha').value = t.fecha || '';
      document.getElementById('trab-estado').value = t.estado || 'Pendiente';
      document.getElementById('trab-desc').value = t.descripcion || '';
      
      tempMediaFiles = t.media ? [...t.media] : [];
      tempAudioFiles = t.audios ? [...t.audios] : [];
      renderTempMediaPreviews();
      renderTempAudioList();

      const select = document.getElementById('trab-cliente');
      select.innerHTML = "";
      data.clientes.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.innerText = c.nombre;
        if(c.id === t.clienteId) opt.selected = true;
        select.appendChild(opt);
      });

      document.getElementById('modal-trabajo-title').innerText = "Editar Trabajo";
      openModal('modal-trabajo');
    }

    function marcarTerminado(id) {
      const t = data.trabajos.find(x => x.id === id);
      if(t) {
        t.estado = 'Terminado';
        t.fechaFin = new Date().toISOString().split('T')[0];
        saveDataToFirebase();
        showToast("¡Trabajo marcado como terminado!", true);
      }
    }

    function renderTerminados() {
      const box = document.getElementById('terminados-list-box');
      const terminados = data.trabajos.filter(t => t.estado === 'Terminado');
      document.getElementById('total-terminados-sub').innerText = terminados.length;

      if(terminados.length === 0) {
        box.innerHTML = `<i class="fa-solid fa-circle-check" style="font-size: 24px; margin-bottom: 8px; color: #10b981;"></i><p>Sin trabajos terminados todavía</p>`;
        return;
      }
      box.className = "";
      box.style.background = "transparent";
      box.style.border = "none";
      box.style.padding = "0";
      box.innerHTML = "";

      terminados.forEach(t => {
        const card = document.createElement('div');
        card.className = "work-card";
        card.style.borderColor = "rgba(16, 185, 129, 0.3)";
        card.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
              <span style="font-size: 12px; background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 3px 8px; border-radius: 4px; font-weight: bold;"><i class="fa-solid fa-circle-check"></i> Terminado</span>
              <h3 style="font-size: 18px; font-weight: bold; margin-top: 6px;">${t.clienteNombre}</h3>
              <p style="font-size: 14px; color: var(--text-muted); margin-top: 2px;">${t.descripcion || 'Sin descripción'}</p>
            </div>
            <button class="btn-primary" style="padding: 8px 14px; width: auto; font-size: 14px;" onclick="openTerminadoDetail('${t.id}')">Ver Detalle</button>
          </div>
          <div style="font-size: 13px; color: var(--text-muted); display: flex; gap: 12px; margin-top: 4px;">
            <span><i class="fa-solid fa-calendar-check"></i> ${t.fechaFin || t.fecha}</span>
            <span><i class="fa-solid fa-camera"></i> ${t.media ? t.media.length : 0} fotos</span>
          </div>
        `;
        box.appendChild(card);
      });
    }

    function openTerminadoDetail(id) {
      const t = data.trabajos.find(x => x.id === id);
      if(!t) return;
      const cliente = data.clientes.find(c => c.id === t.clienteId) || {};

      document.getElementById('term-det-id').value = t.id;
      document.getElementById('term-det-cliente').innerText = t.clienteNombre;
      document.getElementById('term-det-tel').innerHTML = cliente.telefono ? `<a href="https://wa.me/${cliente.telefono.replace(/\D/g,'')}" target="_blank" class="map-link-btn"><i class="fa-brands fa-whatsapp" style="color: #25d366;"></i> ${cliente.telefono}</a>` : 'Sin teléfono';
      document.getElementById('term-det-dir').innerHTML = cliente.direccion ? `<a href="https://maps.google.com/?q=${encodeURIComponent(cliente.direccion)}" target="_blank" class="map-link-btn"><i class="fa-solid fa-map-location-dot"></i> ${cliente.direccion}</a>` : 'Sin dirección';
      
      document.getElementById('term-det-fecha-inicio').innerText = t.fecha || '---';
      document.getElementById('term-det-fecha-fin').innerText = t.fechaFin || '---';
      document.getElementById('term-det-desc').innerText = t.descripcion || 'Sin descripción completa';

      const mediaContainer = document.getElementById('term-det-media');
      mediaContainer.innerHTML = "";
      if(t.media && t.media.length > 0) {
        t.media.forEach(src => {
          const img = document.createElement('img');
          img.src = src;
          img.className = "media-thumb";
          img.onclick = () => openImageVisor(src);
          mediaContainer.appendChild(img);
        });
      } else {
        mediaContainer.innerHTML = "<span style='font-size: 14px; color: var(--text-muted);'>Sin fotos adjuntas</span>";
      }

      const audioContainer = document.getElementById('term-det-audios');
      audioContainer.innerHTML = "";
      if(t.audios && t.audios.length > 0) {
        t.audios.forEach((audioSrc, idx) => {
          const abox = document.createElement('div');
          abox.className = "audio-item-box";
          abox.innerHTML = `
            <span style="font-size: 14px;"><i class="fa-solid fa-microphonelines" style="color: var(--accent-green);"></i> Nota de voz #${idx + 1}</span>
            <audio controls src="${audioSrc}" style="height: 32px; width: 180px;"></audio>
          `;
          audioContainer.appendChild(abox);
        });
      } else {
        audioContainer.innerHTML = "<span style='font-size: 14px; color: var(--text-muted);'>Sin notas de voz grabadas</span>";
      }

      openModal('modal-ver-terminado');
    }

    function deleteTerminadoFromModal() {
      const id = document.getElementById('term-det-id').value;
      if(confirm("¿Estás seguro de eliminar este trabajo finalizado?")) {
        data.trabajos = data.trabajos.filter(t => t.id !== id);
        closeModal('modal-ver-terminado');
        saveDataToFirebase();
        showToast("Trabajo eliminado", true);
      }
    }

    function revertirTrabajoFromModal() {
      const id = document.getElementById('term-det-id').value;
      const t = data.trabajos.find(x => x.id === id);
      if(t) {
        t.estado = 'Pendiente';
        delete t.fechaFin;
        closeModal('modal-ver-terminado');
        saveDataToFirebase();
        showToast("Trabajo revertido a pendiente", true);
      }
    }

    function editTerminadoFromModal() {
      const id = document.getElementById('term-det-id').value;
      closeModal('modal-ver-terminado');
      editTrabajoModal(id);
    }

    function renderRecordatorios() {
      const box = document.getElementById('recordatorios-list-box');
      document.getElementById('count-pendientes').innerText = data.recordatorios.length;
      if(data.recordatorios.length === 0) {
        box.innerHTML = `<i class="fa-regular fa-bell" style="font-size: 24px; margin-bottom: 8px;"></i><p>Sin recordatorios activos</p>`;
        return;
      }
      box.className = "";
      box.style.background = "transparent";
      box.style.border = "none";
      box.style.padding = "0";
      box.innerHTML = "";

      data.recordatorios.forEach(r => {
        const card = document.createElement('div');
        card.className = "recordatorio-card";
        card.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
              <h3 style="font-size: 18px; font-weight: bold; color: var(--text-main);">${r.titulo}</h3>
              <p style="font-size: 14px; color: var(--accent-green); margin-top: 2px;"><i class="fa-solid fa-clock"></i> ${r.tiempo.replace('T', ' ')}</p>
              <p style="font-size: 14px; color: var(--text-muted); margin-top: 4px;">${r.desc || ''}</p>
            </div>
            <button class="btn-danger" style="padding: 6px 10px; font-size: 14px;" onclick="deleteRecordatorio('${r.id}')"><i class="fa-solid fa-trash"></i></button>
          </div>
        `;
        box.appendChild(card);
      });
    }

    function saveRecordatorio(e) {
      e.preventDefault();
      const titulo = document.getElementById('rec-titulo').value;
      const tiempo = document.getElementById('rec-tiempo').value;
      const desc = document.getElementById('rec-desc').value;

      const nuevoRec = {
        id: 'rec_' + Date.now(),
        titulo, tiempo, desc
      };

      data.recordatorios.unshift(nuevoRec);
      closeModal('modal-recordatorio');
      document.getElementById('form-recordatorio').reset();
      saveDataToFirebase();
      showToast("Recordatorio programado", true);
    }

    function deleteRecordatorio(id) {
      data.recordatorios = data.recordatorios.filter(r => r.id !== id);
      saveDataToFirebase();
      showToast("Recordatorio eliminado", true);
    }
  </script>
</body>
</html>
