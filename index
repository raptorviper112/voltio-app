<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Voltio - Gestión para Electricistas</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>

  <style>
    :root {
      --bg-main: #0c0d0e;
      --bg-sidebar: #121315;
      --bg-card: #181a1d;
      --bg-input: #0f1012;
      --accent-green: #10b981;
      --accent-green-hover: #059669;
      --accent-red: #ef4444;
      --text-main: #f3f4f6;
      --text-muted: #9ca3af;
      --border-color: #27272a;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-tap-highlight-color: transparent; }
    body { background-color: var(--bg-main); color: var(--text-main); height: 100vh; overflow: hidden; display: flex; flex-direction: column; font-size: 16px; }
    
    /* PANTALLA DE LOGIN CON DIFUMINADO DUAL IGUALITARIO (VERDE Y ROJO) */
    #auth-screen { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: var(--bg-main); display: flex; justify-content: center; align-items: center; z-index: 2000; padding: 20px; }
    .auth-card { background: var(--bg-card); border: 1px solid var(--border-color); padding: 28px; border-radius: 16px; width: 100%; max-width: 400px; text-align: center; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.2), 0 10px 30px rgba(239, 68, 68, 0.2), 0 10px 25px rgba(0,0,0,0.5); }
    .auth-tabs { display: flex; gap: 8px; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; }
    .auth-tab { flex: 1; background: none; border: none; color: var(--text-muted); font-weight: 600; cursor: pointer; padding: 10px; border-radius: 6px; font-size: 16px; }
    .auth-tab.active { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); box-shadow: 0 0 12px rgba(16, 185, 129, 0.25), 0 0 12px rgba(239, 68, 68, 0.25); }

    /* LAYOUT GENERAL */
    .app-container { display: none; width: 100%; height: 100%; flex-direction: row; }
    
    /* HEADER MÓVIL */
    .mobile-header { display: none; background-color: var(--bg-sidebar); border-bottom: 1px solid var(--border-color); padding: 14px 18px; align-items: center; justify-content: space-between; z-index: 100; box-shadow: 0 4px 20px rgba(16, 185, 129, 0.15), 0 4px 20px rgba(239, 68, 68, 0.15); }
    .hamburger-btn { background: none; border: none; color: var(--accent-green); font-size: 26px; cursor: pointer; padding: 4px; text-shadow: 0 0 8px rgba(16, 185, 129, 0.4), 0 0 8px rgba(239, 68, 68, 0.4); }

    /* SIDEBAR CON DIFUMINADO DUAL */
    .sidebar { width: 280px; background-color: var(--bg-sidebar); border-right: 1px solid var(--border-color); display: flex; flex-direction: column; justify-content: space-between; padding: 20px 16px; z-index: 150; transition: transform 0.25s ease-in-out; box-shadow: 5px 0 25px rgba(16, 185, 129, 0.1), 5px 0 25px rgba(239, 68, 68, 0.1); }
    .brand { display: flex; align-items: center; gap: 12px; font-size: 22px; font-weight: bold; color: var(--text-main); margin-bottom: 25px; text-shadow: 0 0 10px rgba(16, 185, 129, 0.3), 0 0 10px rgba(239, 68, 68, 0.3); }
    .brand-icon { background: linear-gradient(135deg, var(--accent-green), var(--accent-red)); color: #fff; width: 38px; height: 38px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 0 15px rgba(16, 185, 129, 0.4), 0 0 15px rgba(239, 68, 68, 0.4); }
    .nav-list { list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .nav-item { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 8px; color: var(--text-muted); cursor: pointer; font-weight: 600; font-size: 17px; transition: all 0.2s ease; }
    .nav-item:active, .nav-item.active { background: linear-gradient(90deg, rgba(16, 185, 129, 0.15), rgba(239, 68, 68, 0.15)); color: var(--text-main); box-shadow: inset 3px 0 0 var(--accent-green), 0 0 12px rgba(16, 185, 129, 0.2), 0 0 12px rgba(239, 68, 68, 0.2); }
    
    .main-content { flex: 1; overflow-y: auto; padding: 20px; -webkit-overflow-scrolling: touch; }
    .view-section { display: none; }
    .view-section.active { display: block; animation: fadeIn 0.2s ease-in-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
    .page-title { font-size: 26px; font-weight: 700; text-shadow: 0 0 15px rgba(16, 185, 129, 0.25), 0 0 15px rgba(239, 68, 68, 0.25); }
    .page-subtitle { font-size: 15px; color: var(--text-muted); margin-top: 4px; }
    
    .btn-primary { background: linear-gradient(135deg, var(--accent-green), var(--accent-red)); color: #fff; border: none; padding: 14px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; justify-content: center; width: 100%; font-size: 17px; box-shadow: 0 0 15px rgba(16, 185, 129, 0.35), 0 0 15px rgba(239, 68, 68, 0.35); }
    .btn-primary:active { opacity: 0.9; transform: scale(0.98); }
    .btn-secondary { background-color: transparent; color: var(--text-main); border: 1px solid var(--border-color); padding: 14px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 17px; }
    .btn-danger { background-color: var(--accent-red); color: #fff; border: none; padding: 10px 14px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 15px; box-shadow: 0 0 12px rgba(239, 68, 68, 0.5); }
    .btn-success { background-color: var(--accent-green); color: #fff; border: none; padding: 10px 14px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 15px; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 0 12px rgba(16, 185, 129, 0.5); }
    .btn-warning { background-color: #f59e0b; color: #000; border: none; padding: 10px 14px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 15px; display: inline-flex; align-items: center; gap: 6px; }
    .btn-record { background-color: var(--accent-red); color: #fff; border: none; padding: 10px 14px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 15px; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 0 12px rgba(239, 68, 68, 0.5); }
    .btn-record.recording { animation: pulseRec 1.5s infinite; }
    @keyframes pulseRec { 0% { opacity: 1; box-shadow: 0 0 20px rgba(239, 68, 68, 0.8); } 50% { opacity: 0.5; box-shadow: 0 0 5px rgba(239, 68, 68, 0.2); } 100% { opacity: 1; box-shadow: 0 0 20px rgba(239, 68, 68, 0.8); } }

    .map-link-btn { color: var(--accent-green); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; background: rgba(16, 185, 129, 0.08); padding: 6px 10px; border-radius: 6px; border: 1px solid rgba(16, 185, 129, 0.2); font-size: 14px; font-weight: 500; cursor: pointer; }

    /* TARJETAS DEL PANEL CON DIFUMINADO DUAL */
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 14px; margin-bottom: 24px; }
    .stat-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 18px; cursor: pointer; user-select: none; transition: box-shadow 0.2s; }
    .stat-card:active { transform: scale(0.96); border-color: var(--accent-green); box-shadow: 0 0 15px rgba(16, 185, 129, 0.25), 0 0 15px rgba(239, 68, 68, 0.25); }
    .stat-icon { width: 42px; height: 42px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.04); display: flex; align-items: center; justify-content: center; margin-bottom: 10px; font-size: 18px; color: var(--accent-green); text-shadow: 0 0 8px rgba(16, 185, 129, 0.4), 0 0 8px rgba(239, 68, 68, 0.4); }
    .stat-value { font-size: 26px; font-weight: 700; }
    .stat-label { font-size: 13px; color: var(--text-muted); margin-top: 4px; font-weight: 500; }

    .content-box { background-color: var(--bg-card); border: 1px dashed var(--border-color); border-radius: 12px; padding: 35px 20px; text-align: center; color: var(--text-muted); font-size: 16px; }
    
    /* TARJETAS DE CLIENTES Y TRABAJOS */
    .client-card, .work-card, .recordatorio-card { background: var(--bg-card); padding: 16px; border: 1px solid var(--border-color); border-radius: 10px; text-align: left; display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.05), 0 4px 15px rgba(239, 68, 68, 0.05); }
    .client-links { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
    .client-links a, .client-links span { color: var(--accent-green); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; background: rgba(16, 185, 129, 0.08); padding: 8px 12px; border-radius: 6px; border: 1px solid rgba(16, 185, 129, 0.2); font-size: 14px; font-weight: 500; }

    /* NOTIFICACIÓN TOAST FLOTANTE CON BRILLO VERDE/ROJO */
    #toast-notification { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%) translateY(100px); background: #1f2937; color: #f3f4f6; border: 1px solid var(--border-color); padding: 12px 20px; border-radius: 12px; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.25), 0 10px 30px rgba(239, 68, 68, 0.25), 0 10px 25px rgba(0,0,0,0.6); display: flex; align-items: center; gap: 10px; z-index: 3000; transition: transform 0.3s ease-in-out, background 0.3s; font-size: 15px; font-weight: 500; max-width: 90vw; }
    #toast-notification.show { transform: translateX(-50%) translateY(0); }
    #toast-notification.success { background: linear-gradient(135deg, #065f46, #991b1b); border-color: #10b981; color: #fff; box-shadow: 0 0 20px rgba(16, 185, 129, 0.4), 0 0 20px rgba(239, 68, 68, 0.4); }

    /* MODALES CON DIFUMINADO DUAL EQUILIBRADO */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.8); display: none; justify-content: center; align-items: center; z-index: 1000; padding: 12px; backdrop-filter: blur(2px); }
    .modal-overlay.active { display: flex; }
    .modal-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; width: 100%; max-width: 480px; padding: 24px; max-height: 94vh; overflow-y: auto; box-shadow: 0 15px 40px rgba(16, 185, 129, 0.2), 0 15px 40px rgba(239, 68, 68, 0.2), 0 10px 30px rgba(0,0,0,0.8); }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
    .modal-body { display: grid; gap: 14px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; text-align: left; }
    .form-group label { font-size: 13px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; }
    .input-field { background-color: var(--bg-input); border: 1px solid var(--border-color); border-radius: 8px; padding: 14px 16px; color: var(--text-main); outline: none; width: 100%; font-size: 17px; }
    .input-field:focus { border-color: var(--accent-green); box-shadow: 0 0 10px rgba(16, 185, 129, 0.3), 0 0 10px rgba(239, 68, 68, 0.3); }
    .modal-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 24px; gap: 10px; flex-wrap: wrap; }
    .row-2 { display: grid; grid-template-columns: 1fr; gap: 14px; }

    .media-preview-container { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
    .media-thumb { width: 64px; height: 64px; border-radius: 6px; object-fit: cover; border: 1px solid var(--border-color); cursor: pointer; }
    .audio-item-box { display: flex; align-items: center; justify-content: space-between; background: var(--bg-input); padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border-color); margin-top: 6px; gap: 10px; }

    @media (max-width: 768px) {
      body { overflow: auto; }
      .app-container { flex-direction: column; height: auto; min-height: 100vh; }
      .mobile-header { display: flex; }
      .sidebar { position: fixed; top: 0; left: -300px; height: 100vh; width: 300px; box-shadow: 10px 0 30px rgba(16, 185, 129, 0.2), 10px 0 30px rgba(239, 68, 68, 0.2); }
      .sidebar.mobile-open { left: 0; }
      .main-content { padding: 14px; }
    }
  </style>
</head>
<body>

  <div id="toast-notification">
    <i id="toast-icon" class="fa-solid fa-cloud-arrow-up" style="color: var(--accent-green); font-size: 18px; text-shadow: 0 0 8px rgba(16, 185, 129, 0.5), 0 0 8px rgba(239, 68, 68, 0.5);"></i>
    <span id="toast-message">Guardando en segundo plano...</span>
  </div>

  <div id="auth-screen">
    <div class="auth-card">
      <div class="brand" style="justify-content: center; margin-bottom: 20px;">
        <div class="brand-icon"><i class="fa-solid fa-bolt"></i></div>
        <span>Voltio</span>
      </div>
      
      <div class="auth-tabs">
        <button class="auth-tab active" id="tab-login-btn" onclick="switchAuthMode('login')">Iniciar Sesión</button>
        <button class="auth-tab" id="tab-reg-btn" onclick="switchAuthMode('register')">Crear Cuenta</button>
      </div>

      <div class="modal-body">
        <div class="form-group">
          <label>Correo Electrónico</label>
          <input type="email" id="auth-email" class="input-field" placeholder="electricista@voltio.com" autocapitalize="none">
        </div>
        <div class="form-group">
          <label>Contraseña</label>
          <input type="password" id="auth-password" class="input-field" placeholder="••••••••">
        </div>
        <button class="btn-primary" id="auth-submit-btn" onclick="handleAuth()" style="margin-top: 10px;">Entrar</button>
      </div>
    </div>
  </div>

  <div class="app-container" id="app-container">
    <header class="mobile-header">
      <div style="display: flex; align-items: center; gap: 12px;">
        <div class="brand-icon" style="width: 32px; height: 32px; font-size: 16px;"><i class="fa-solid fa-bolt"></i></div>
        <span style="font-weight: bold; font-size: 19px; text-shadow: 0 0 10px rgba(16, 185, 129, 0.3), 0 0 10px rgba(239, 68, 68, 0.3);">Voltio</span>
      </div>
      <button class="hamburger-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
    </header>

    <aside class="sidebar" id="sidebar">
      <div>
        <div class="brand" style="display: flex; justify-content: space-between; align-items: center;">
          <div style="display: flex; align-items: center; gap: 12px;">
            <div class="brand-icon"><i class="fa-solid fa-bolt"></i></div>
            <span>Voltio</span>
          </div>
          <button class="hamburger-btn" style="display: none; font-size: 20px;" id="close-menu-btn" onclick="toggleSidebar()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <ul class="nav-list">
          <li class="nav-item active" onclick="switchTab('panel', this)"><i class="fa-solid fa-chart-pie"></i> Panel</li>
          <li class="nav-item" onclick="switchTab('clientes', this)"><i class="fa-solid fa-users"></i> Clientes</li>
          <li class="nav-item" onclick="switchTab('trabajos', this)"><i class="fa-solid fa-clock"></i> Pendientes</li>
          <li class="nav-item" onclick="switchTab('en-curso', this)"><i class="fa-solid fa-spinner"></i> En Curso</li>
          <li class="nav-item" onclick="switchTab('terminados', this)"><i class="fa-solid fa-circle-check"></i> Terminados</li>
          <li class="nav-item" onclick="switchTab('recordatorios', this)"><i class="fa-solid fa-bell"></i> Recordatorios</li>
        </ul>
      </div>
      <div style="font-size: 13px; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 14px; display: flex; justify-content: space-between; align-items: center;">
        <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 190px;">Sesión: <br><strong id="current-user-label" style="color: var(--accent-green);">---</strong></div>
        <button onclick="logoutApp()" style="background:none; border:none; color: var(--accent-green); cursor:pointer; font-size: 20px; padding: 4px; text-shadow: 0 0 8px rgba(16, 185, 129, 0.4), 0 0 8px rgba(239, 68, 68, 0.4);" title="Cerrar Sesión"><i class="fa-solid fa-right-from-bracket"></i></button>
      </div>
    </aside>

    <main class="main-content">
      <section id="panel" class="view-section active">
        <div class="page-header">
          <div><h1 class="page-title">Panel General</h1><p class="page-subtitle">Resumen y accesos directos</p></div>
        </div>
        <div class="stats-grid">
          <div class="stat-card" onclick="switchTabBySelector('clientes', 1)">
            <div class="stat-icon"><i class="fa-solid fa-user-group"></i></div>
            <div class="stat-value" id="count-clientes">0</div>
            <div class="stat-label">Clientes</div>
          </div>
          <div class="stat-card" onclick="switchTabBySelector('trabajos', 2)">
            <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
            <div class="stat-value" id="count-trabajos">0</div>
            <div class="stat-label">Pendientes</div>
          </div>
          <div class="stat-card" onclick="switchTabBySelector('en-curso', 3)">
            <div class="stat-icon" style="color: #3b82f6;"><i class="fa-solid fa-spinner"></i></div>
            <div class="stat-value" id="count-en-curso">0</div>
            <div class="stat-label">En Curso</div>
          </div>
          <div class="stat-card" onclick="switchTabBySelector('terminados', 4)">
            <div class="stat-icon" style="color: #10b981;"><i class="fa-solid fa-circle-check"></i></div>
            <div class="stat-value" id="count-terminados">0</div>
            <div class="stat-label">Terminados</div>
          </div>
          <div class="stat-card" onclick="switchTabBySelector('recordatorios', 5)">
            <div class="stat-icon"><i class="fa-solid fa-bell"></i></div>
            <div class="stat-value" id="count-pendientes">0</div>
            <div class="stat-label">Avisos</div>
          </div>
        </div>
      </section>

      <section id="clientes" class="view-section">
        <div class="page-header">
          <div><h1 class="page-title">Clientes</h1><p class="page-subtitle"><span id="total-clientes-sub">0</span> registrados</p></div>
          <button class="btn-primary" style="width: auto;" onclick="openCreateClientModal()"><i class="fa-solid fa-plus"></i> Nuevo Cliente</button>
        </div>
        <div class="content-box" id="clientes-list-box"><i class="fa-solid fa-user-slash" style="font-size: 24px; margin-bottom: 8px;"></i><p>No hay clientes aún</p></div>
      </section>

      <section id="trabajos" class="view-section">
        <div class="page-header">
          <div><h1 class="page-title">Trabajos Pendientes</h1><p class="page-subtitle"><span id="total-trabajos-sub">0</span> por iniciar</p></div>
          <button class="btn-primary" style="width: auto;" onclick="openCreateTrabajoModal()"><i class="fa-solid fa-plus"></i> Nuevo Trabajo</button>
        </div>
        <div class="content-box" id="trabajos-list-box"><i class="fa-solid fa-screwdriver-wrench" style="font-size: 24px; margin-bottom: 8px;"></i><p>No hay trabajos pendientes</p></div>
      </section>

      <section id="en-curso" class="view-section">
        <div class="page-header">
          <div><h1 class="page-title">Trabajos En Curso</h1><p class="page-subtitle"><span id="total-en-curso-sub">0</span> en ejecución</p></div>
          <button class="btn-primary" style="width: auto;" onclick="openCreateTrabajoModal()"><i class="fa-solid fa-plus"></i> Nuevo Trabajo</button>
        </div>
        <div class="content-box" id="en-curso-list-box"><i class="fa-solid fa-spinner" style="font-size: 24px; margin-bottom: 8px; color: #3b82f6;"></i><p>No hay trabajos en curso</p></div>
      </section>

      <section id="terminados" class="view-section">
        <div class="page-header">
          <div><h1 class="page-title">Trabajos Terminados</h1><p class="page-subtitle"><span id="total-terminados-sub">0</span> finalizados</p></div>
        </div>
        <div class="content-box" id="terminados-list-box"><i class="fa-solid fa-circle-check" style="font-size: 24px; margin-bottom: 8px; color: #10b981;"></i><p>Sin trabajos terminados todavía</p></div>
      </section>

      <section id="recordatorios" class="view-section">
        <div class="page-header">
          <div><h1 class="page-title">Recordatorios</h1><p class="page-subtitle">Avisos y alarmas programadas</p></div>
          <button class="btn-primary" style="width: auto;" onclick="openModal('modal-recordatorio')"><i class="fa-solid fa-bell"></i> Programar</button>
        </div>
        <div class="content-box" id="recordatorios-list-box"><i class="fa-regular fa-bell" style="font-size: 24px; margin-bottom: 8px;"></i><p>Sin recordatorios activos</p></div>
      </section>
    </main>
  </div>

  <div class="modal-overlay" id="modal-detalle-cliente">
    <div class="modal-card">
      <div class="modal-header">
        <h3 id="modal-cli-title" style="font-size: 20px;">Detalles del Cliente</h3>
        <i class="fa-solid fa-xmark" style="cursor:pointer; font-size: 22px; padding: 4px;" onclick="closeModal('modal-detalle-cliente')"></i>
      </div>
      <form id="form-detalle-cliente" onsubmit="updateCliente(event)">
        <input type="hidden" id="edit-cli-id">
        <div class="modal-body">
          <div class="form-group"><label>Nombre *</label><input type="text" id="edit-cli-nombre" class="input-field" required></div>
          <div class="row-2">
            <div class="form-group"><label>Teléfono (WhatsApp)</label><input type="tel" id="edit-cli-telefono" class="input-field"></div>
            <div class="form-group"><label>Email</label><input type="email" id="edit-cli-email" class="input-field"></div>
          </div>
          <div class="form-group"><label>Dirección / Ubicación GPS</label><input type="text" id="edit-cli-direccion" class="input-field" placeholder="Ej: Av. Corrientes 1234, Buenos Aires"></div>
          <div class="form-group"><label>Notas Escritas</label><textarea id="edit-cli-notas" class="input-field" rows="2"></textarea></div>
        </div>
